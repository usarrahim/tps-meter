# Environment
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Data: the full synthetic dataset (several GB) lives on Google Drive and can be regenerated from the
# seeds in configs/dataset_v1.yaml. Only the small pilot / development splits and the manifest are kept.
data/*
!data/.gitkeep
!data/synthetic/
data/synthetic/*
!data/synthetic/v1/
data/synthetic/v1/*
!data/synthetic/v1/pilot.h5
!data/synthetic/v1/dev_faulty.h5
!data/synthetic/v1/manifest.json

# Training runs and model artifacts ARE tracked (private repository): weights (*.pt), ONNX exports and
# normalisers under runs/ and models/. Keep every file below GitHub's 100 MB limit.

# Build outputs and bundles (code packages, evaluation bundles)
dist/
*.zip

# Local tooling / secrets
.env
.env.*
*.key
